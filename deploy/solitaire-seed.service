# Install: sudo cp deploy/solitaire-seed.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now solitaire-seed
[Unit]
Description=Solitaire seed solver API
After=network.target

[Service]
User=zfazek
WorkingDirectory=/home/zfazek/git/solitaire
Environment=HOST=127.0.0.1 PORT=3000 TRUST_PROXY=1
ExecStart=/usr/bin/env npm run serve
Restart=always

[Install]
WantedBy=multi-user.target
