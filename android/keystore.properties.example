# Release signing credentials for the Android app.
#
# Copy this file to `keystore.properties` (same directory) and fill in the real
# values. `keystore.properties` is gitignored so your keystore path and
# passwords never get committed.
#
# Create the keystore first (once — keep the .jks file safe and backed up;
# losing it means you can no longer publish updates under the same app):
#
#   keytool -genkey -v -keystore ~/keystores/osolitaire-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias osolitaire
#
# Then build a signed release from the android/ directory:
#
#   ./gradlew assembleRelease   # -> app/build/outputs/apk/release/app-release.apk
#   ./gradlew bundleRelease     # -> app/build/outputs/bundle/release/app-release.aab (Play Store)
#
# Remember to refresh the web assets first:  npm run build && npx cap sync android

storeFile=/absolute/path/to/osolitaire-release.jks
storePassword=your-keystore-password
keyAlias=osolitaire
keyPassword=your-key-password
